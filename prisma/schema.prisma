// OmniRouter AI — data model
//
// Design notes
//  * Every tenant-scoped table carries workspaceId so isolation can be enforced
//    with a single predicate and indexed efficiently.
//  * Secrets are never stored in plaintext: provider credentials are AES-256-GCM
//    ciphertext, virtual API keys are stored as a SHA-256 hash plus a display prefix.
//  * AuditLog is append-only by convention; no update or delete path exists in the
//    application layer.
//  * Request/RequestAttempt form the trace: one request, ordered provider attempts.
//  * Content logging defaults to METADATA_ONLY — prompt and response bodies are not
//    persisted unless a workspace explicitly opts in.

// Prisma 7: connection URLs live in prisma.config.ts, not here, and the client
// connects through the pg driver adapter (see lib/database/client.ts).
generator client {
  provider = "prisma-client"
  output   = "../lib/database/generated"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum WorkspaceRole {
  OWNER
  ADMIN
  DEVELOPER
  ANALYST
  VIEWER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  LOCKED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum EnvironmentType {
  DEVELOPMENT
  PRODUCTION
}

enum ProviderKind {
  DEMO
  OPENAI
  ANTHROPIC
  GEMINI
  OPENROUTER
  DEEPSEEK
  OLLAMA
}

enum ConnectionStatus {
  ACTIVE
  DISABLED
  MISCONFIGURED
}

enum HealthState {
  HEALTHY
  DEGRADED
  UNAVAILABLE
  UNKNOWN
}

enum RoutingStrategy {
  MANUAL
  PRIORITY
  WEIGHTED
  LOWEST_ESTIMATED_COST
  LOWEST_RECENT_LATENCY
  RELIABILITY_FIRST
  CAPABILITY_MATCH
  BALANCED
}

enum PolicyStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum RequestStatus {
  SUCCEEDED
  FAILED
  REJECTED
}

enum AttemptStatus {
  SUCCEEDED
  FAILED
  TIMED_OUT
  SKIPPED
}

// Failure taxonomy. Drives retry and fallback policy — see lib/ai/errors.
enum ErrorCategory {
  AUTHENTICATION
  PERMISSION
  RATE_LIMIT
  TIMEOUT
  PROVIDER_UNAVAILABLE
  INVALID_REQUEST
  CONTEXT_LIMIT
  SAFETY_REFUSAL
  MALFORMED_RESPONSE
  NETWORK
  QUOTA_EXCEEDED
  UNKNOWN
  CLIENT_CANCELLED
}

enum ContentLoggingMode {
  METADATA_ONLY
  REDACTED
  FULL_CONTENT
}

enum QuotaAction {
  WARN
  REJECT
  ROUTE_LOWER_COST
}

enum QuotaWindow {
  MINUTE
  DAY
  MONTH
}

enum KeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  name           String
  passwordHash   String
  status         AccountStatus @default(ACTIVE)
  isDemoAccount  Boolean       @default(false)
  failedLogins   Int           @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  sessions          Session[]
  memberships       WorkspaceMember[]
  auditLogs         AuditLog[]
  sentInvitations   Invitation[]      @relation("InvitedBy")

  @@index([status])
  @@map("users")
}

model Session {
  id         String   @id @default(cuid())
  // SHA-256 of the session token. The raw token exists only in the cookie.
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  ipHash     String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Workspace {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  contentLoggingMode ContentLoggingMode @default(METADATA_ONLY)
  isDemoWorkspace    Boolean            @default(false)
  // Guards destructive operations in shared/public demo deployments.
  isProtected        Boolean            @default(false)
  archivedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  members           WorkspaceMember[]
  invitations       Invitation[]
  applications      Application[]
  providers         ProviderConnection[]
  models            ModelDefinition[]
  policies          RoutingPolicy[]
  apiKeys           VirtualAPIKey[]
  prompts           Prompt[]
  requests          Request[]
  usageDaily        UsageDaily[]
  quotas            Quota[]
  healthChecks      ProviderHealthCheck[]
  auditLogs         AuditLog[]
  demoScenarios     DemoScenario[]
  budgets           Budget[]
  evaluationSuites  EvaluationSuite[]

  @@index([archivedAt])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(VIEWER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
  @@map("workspace_members")
}

model Invitation {
  id          String           @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole    @default(VIEWER)
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email, status])
  @@index([workspaceId])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Applications and environments
// ---------------------------------------------------------------------------

model Application {
  id                String    @id @default(cuid())
  workspaceId       String
  name              String
  slug              String
  description       String?
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  environments Environment[]
  apiKeys      VirtualAPIKey[]
  requests     Request[]
  usageDaily   UsageDaily[]
  quotas       Quota[]
  policies     RoutingPolicy[]
  budgets      Budget[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, archivedAt])
  @@map("applications")
}

model Environment {
  id              String          @id @default(cuid())
  applicationId   String
  type            EnvironmentType
  defaultPolicyId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  defaultPolicy RoutingPolicy? @relation("EnvironmentDefaultPolicy", fields: [defaultPolicyId], references: [id], onDelete: SetNull)
  apiKeys       VirtualAPIKey[]
  requests      Request[]
  usageDaily    UsageDaily[]
  quotas        Quota[]
  budgets       Budget[]

  @@unique([applicationId, type])
  @@map("environments")
}

// ---------------------------------------------------------------------------
// Providers and models
// ---------------------------------------------------------------------------

model ProviderConnection {
  id          String           @id @default(cuid())
  workspaceId String
  kind        ProviderKind
  label       String
  // AES-256-GCM ciphertext (iv:tag:data). Null for DEMO and OLLAMA.
  credentialCiphertext String?
  baseUrl     String?
  status      ConnectionStatus @default(ACTIVE)
  healthState HealthState      @default(UNKNOWN)
  lastCheckedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace    Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  models       ModelDefinition[]
  healthChecks ProviderHealthCheck[]

  @@unique([workspaceId, kind, label])
  @@index([workspaceId, status])
  @@map("provider_connections")
}

model ModelDefinition {
  id           String  @id @default(cuid())
  workspaceId  String
  connectionId String
  // Provider-native identifier, e.g. "astra-fast" or "gpt-4o-mini".
  modelId      String
  displayName  String
  isDemoModel  Boolean @default(false)

  contextWindow          Int
  supportsStreaming      Boolean @default(true)
  supportsStructured     Boolean @default(false)
  supportsVision         Boolean @default(false)
  supportsToolUse        Boolean @default(false)

  // Workspace-configured pricing in USD per million tokens. Estimates only.
  inputPricePerMillion   Decimal @default(0) @db.Decimal(12, 4)
  outputPricePerMillion  Decimal @default(0) @db.Decimal(12, 4)

  isAvailable  Boolean     @default(true)
  healthState  HealthState @default(UNKNOWN)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  rules      RoutingRule[]
  attempts   RequestAttempt[]
  evaluationRuns EvaluationRun[]
  qualityScores ModelQualityScore[]

  @@unique([connectionId, modelId])
  @@index([workspaceId, isAvailable])
  @@map("model_definitions")
}

model ProviderHealthCheck {
  id           String      @id @default(cuid())
  workspaceId  String
  connectionId String
  state        HealthState
  latencyMs    Int?
  detail       String?
  checkedAt    DateTime    @default(now())

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, checkedAt])
  @@index([workspaceId, checkedAt])
  @@map("provider_health_checks")
}

// ---------------------------------------------------------------------------
// Routing
// ---------------------------------------------------------------------------

model RoutingPolicy {
  id            String          @id @default(cuid())
  workspaceId   String
  applicationId String?
  name          String
  description   String?
  strategy      RoutingStrategy @default(BALANCED)
  status        PolicyStatus    @default(DRAFT)
  version       Int             @default(1)

  maxAttempts       Int      @default(3)
  attemptTimeoutMs  Int      @default(30000)
  totalTimeoutMs    Int      @default(60000)
  maxEstimatedCost  Decimal? @db.Decimal(12, 6)

  // Capability requirements and strategy weights. JSONB is justified here:
  // the shape varies per strategy and must stay editable without migration.
  requirements Json @default("{}")
  scoring      Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace           Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  application         Application?  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  rules               RoutingRule[]
  requests            Request[]
  defaultForEnvironments Environment[] @relation("EnvironmentDefaultPolicy")
  evaluationRuns      EvaluationRun[]

  @@unique([workspaceId, name])
  @@index([workspaceId, status])
  @@map("routing_policies")
}

model RoutingRule {
  id       String @id @default(cuid())
  policyId String
  modelId  String
  // Lower number = evaluated earlier for PRIORITY and fallback ordering.
  priority Int    @default(1)
  // Relative weight for WEIGHTED selection.
  weight   Int    @default(1)
  enabled  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  policy RoutingPolicy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  model  ModelDefinition @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([policyId, modelId])
  @@index([policyId, priority])
  @@map("routing_rules")
}

// ---------------------------------------------------------------------------
// Virtual API keys
// ---------------------------------------------------------------------------

model VirtualAPIKey {
  id            String    @id @default(cuid())
  workspaceId   String
  applicationId String
  environmentId String
  name          String
  // Display-only, e.g. "omr_dev_a1b2c3". Never sufficient to authenticate.
  keyPrefix     String
  // SHA-256 of the full key. The plaintext is shown once at creation and never stored.
  keyHash       String    @unique
  scopes        String[]  @default([])
  status        KeyStatus @default(ACTIVE)
  expiresAt     DateTime?
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  requests    Request[]

  @@index([workspaceId, status])
  @@index([applicationId])
  @@map("virtual_api_keys")
}

// ---------------------------------------------------------------------------
// Prompt registry
// ---------------------------------------------------------------------------

model Prompt {
  id              String    @id @default(cuid())
  workspaceId     String
  name            String
  description     String?
  activeVersionId String?   @unique
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions      PromptVersion[] @relation("PromptVersions")
  activeVersion PromptVersion?  @relation("ActivePromptVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, name])
  @@index([workspaceId, archivedAt])
  @@map("prompts")
}

model PromptVersion {
  id           String   @id @default(cuid())
  promptId     String
  version      Int
  systemPrompt String
  userTemplate String
  // Declared template variables, e.g. ["customer_name","tone"].
  variables    String[] @default([])
  changeNote   String?
  testCases    Json     @default("[]")
  createdAt    DateTime @default(now())

  prompt      Prompt  @relation("PromptVersions", fields: [promptId], references: [id], onDelete: Cascade)
  activeFor   Prompt? @relation("ActivePromptVersion")
  evaluationRuns EvaluationRun[]

  @@unique([promptId, version])
  @@index([promptId])
  @@map("prompt_versions")
}

// ---------------------------------------------------------------------------
// Request trace
// ---------------------------------------------------------------------------

model Request {
  id            String @id @default(cuid())
  workspaceId   String
  applicationId String
  environmentId String
  apiKeyId      String?
  policyId      String?

  // Client-visible identifier returned in responses and headers.
  correlationId  String  @unique
  // Optional client-supplied key; enforces at-most-once execution per workspace.
  idempotencyKey String?

  status        RequestStatus
  errorCategory ErrorCategory?
  errorMessage  String?

  requestedModel String?
  resolvedModel  String?
  fallbackUsed   Boolean @default(false)
  attemptCount   Int     @default(0)

  inputTokens    Int     @default(0)
  outputTokens   Int     @default(0)
  totalTokens    Int     @default(0)
  estimatedCost  Decimal @default(0) @db.Decimal(12, 6)
  totalLatencyMs Int     @default(0)

  // Persisted, human-readable record of why this route was chosen.
  // Storing it makes a past decision auditable after policies change.
  routeExplanation Json?
  // Ordered lifecycle stages for the trace viewer.
  traceStages      Json?

  // Populated only when the workspace opts out of METADATA_ONLY.
  promptPreview   String?
  responsePreview String?

  source    String   @default("api")
  createdAt DateTime @default(now())

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  application Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  environment Environment      @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  apiKey      VirtualAPIKey?   @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  policy      RoutingPolicy?   @relation(fields: [policyId], references: [id], onDelete: SetNull)
  attempts    RequestAttempt[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, createdAt])
  @@index([applicationId, createdAt])
  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, errorCategory])
  @@index([environmentId, createdAt])
  @@map("requests")
}

model RequestAttempt {
  id        String @id @default(cuid())
  requestId String
  modelId   String?

  // 1-based position in the attempt sequence.
  sequence      Int
  status        AttemptStatus
  providerKind  ProviderKind
  modelLabel    String
  errorCategory ErrorCategory?
  errorMessage  String?

  inputTokens   Int     @default(0)
  outputTokens  Int     @default(0)
  estimatedCost Decimal @default(0) @db.Decimal(12, 6)
  latencyMs     Int     @default(0)

  providerRequestId String?
  // Why this attempt happened: initial selection, retry or fallback.
  reason            String?
  startedAt         DateTime @default(now())
  completedAt       DateTime?

  request Request          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  model   ModelDefinition? @relation(fields: [modelId], references: [id], onDelete: SetNull)

  @@unique([requestId, sequence])
  @@index([requestId])
  @@map("request_attempts")
}

// ---------------------------------------------------------------------------
// Aggregates, quotas, audit
// ---------------------------------------------------------------------------

// Daily rollup at the environment grain.
//
// modelId is deliberately absent from this table. A compound unique containing
// a nullable column does not constrain anything in PostgreSQL, because NULLs
// compare as distinct — two "no model" rows for the same day would both insert.
// Per-model analytics is derived from RequestAttempt instead, which carries the
// model on every row and is already indexed for it.
model UsageDaily {
  id            String   @id @default(cuid())
  workspaceId   String
  applicationId String
  environmentId String
  // Truncated to UTC midnight.
  day           DateTime @db.Date

  requestCount   Int     @default(0)
  successCount   Int     @default(0)
  failureCount   Int     @default(0)
  fallbackCount  Int     @default(0)
  inputTokens    Int     @default(0)
  outputTokens   Int     @default(0)
  estimatedCost  Decimal @default(0) @db.Decimal(12, 6)
  totalLatencyMs BigInt  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, applicationId, environmentId, day])
  @@index([workspaceId, day])
  @@map("usage_daily")
}

model Quota {
  id            String      @id @default(cuid())
  workspaceId   String
  applicationId String?
  environmentId String?
  name          String
  window        QuotaWindow
  // Null means that dimension is unlimited.
  maxRequests   Int?
  maxTokens     Int?
  maxCost       Decimal?    @db.Decimal(12, 6)
  // Fraction of the limit that triggers a warning, e.g. 0.8.
  warnThreshold Decimal     @default(0.8) @db.Decimal(4, 3)
  action        QuotaAction @default(REJECT)
  enabled       Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  environment Environment? @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([workspaceId, enabled])
  @@map("quotas")
}

model AuditLog {
  id            String   @id @default(cuid())
  workspaceId   String
  actorId       String?
  actorLabel    String
  action        String
  resourceType  String
  resourceId    String?
  previousState Json?
  newState      Json?
  correlationId String?
  ipHash        String?
  createdAt     DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, resourceType])
  @@index([actorId])
  @@map("audit_logs")
}

model DemoScenario {
  id          String   @id @default(cuid())
  workspaceId String
  key         String
  title       String
  description String
  // Fault-injection directives interpreted by the demo provider.
  behaviour   Json     @default("{}")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId, sortOrder])
  @@map("demo_scenarios")
}

// ---------------------------------------------------------------------------
// Budgets
// ---------------------------------------------------------------------------

enum BudgetPeriod {
  DAY
  MONTH
}

model Budget {
  id                 String       @id @default(cuid())
  workspaceId        String
  applicationId      String?
  environmentId      String?
  period             BudgetPeriod
  periodStart        DateTime
  periodEnd          DateTime
  maxSpend           Decimal      @db.Decimal(12, 6)
  warnThreshold      Decimal      @default(0.8) @db.Decimal(4, 3)
  spent              Decimal      @default(0) @db.Decimal(12, 6)
  reserved           Decimal      @default(0) @db.Decimal(12, 6)
  reservationExpiresAt DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  environment Environment? @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, applicationId, environmentId, period, periodStart])
  @@index([workspaceId, period, periodStart])
  @@map("budgets")
}

// ---------------------------------------------------------------------------
// Evaluations
// ---------------------------------------------------------------------------

enum EvaluationStatus {
  PASSED
  FAILED
  ERROR
}

model EvaluationSuite {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String
  capability  String   // Capability enum as string
  testCases   Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs       EvaluationRun[]
  qualityScores ModelQualityScore[]

  @@unique([workspaceId, name])
  @@map("evaluation_suites")
}

model EvaluationRun {
  id                String          @id @default(cuid())
  suiteId           String
  modelDefinitionId String
  providerKind      String
  promptVersionId   String?
  policyId          String?
  score             Float           // 0-1
  latencyMs         Int
  tokens            Int
  cost              Float
  status            EvaluationStatus
  errorMessage      String?
  completedAt       DateTime        @default(now())

  suite         EvaluationSuite       @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  model         ModelDefinition       @relation(fields: [modelDefinitionId], references: [id], onDelete: Cascade)
  promptVersion PromptVersion?        @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)
  policy        RoutingPolicy?        @relation(fields: [policyId], references: [id], onDelete: SetNull)

  @@index([suiteId, modelDefinitionId])
  @@index([modelDefinitionId, completedAt])
  @@map("evaluation_runs")
}

model ModelQualityScore {
  modelDefinitionId String
  evaluationSuiteId String
  capability        String
  score             Float
  sampleSize        Int
  evaluatedAt       DateTime
  evaluationVersion String

  model     ModelDefinition   @relation(fields: [modelDefinitionId], references: [id], onDelete: Cascade)
  suite     EvaluationSuite   @relation(fields: [evaluationSuiteId], references: [id], onDelete: Cascade)

  @@id([modelDefinitionId, evaluationSuiteId])
  @@map("model_quality_scores")
}
